# Copy to .dev.vars for local Cloudflare development. Never commit .dev.vars.
ROOTINE_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
ROOTINE_ASSISTANT_ALLOWED_ORIGINS=http://localhost:5173
ROOTINE_ASSISTANT_ACCESS_TOKEN=
ROOTINE_ASSISTANT_MAX_SESSION_MINUTES=10
ROOTINE_ASSISTANT_IDLE_TIMEOUT_SECONDS=120
ROOTINE_ASSISTANT_UPSTREAM_TIMEOUT_MS=12000
ROOTINE_ASSISTANT_RATE_LIMIT=5
ROOTINE_ASSISTANT_RATE_WINDOW_SECONDS=60
OPEN_FOOD_FACTS_CONTACT=
