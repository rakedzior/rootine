// Copy this file to Secrets.xcconfig. The copied file is ignored by Git.
// Client builds use only a Supabase publishable/anon key, never service role.
ROOTINE_SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
ROOTINE_SUPABASE_PUBLISHABLE_KEY = YOUR_PUBLISHABLE_KEY
ROOTINE_BACKEND_URL = https:/$()/YOUR_ROOTINE_BACKEND.example
ROOTINE_AUTH_CALLBACK_SCHEME = rootine
ROOTINE_TERMS_URL = https:/$()/YOUR_ROOTINE_WEB.example/regulamin
ROOTINE_PRIVACY_URL = https:/$()/YOUR_ROOTINE_WEB.example/polityka-prywatnosci
DEVELOPMENT_TEAM = YOUR_APPLE_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER = YOUR_REVERSED_DOMAIN.rootine
