// Xcode 26.3 ships Swift 6.2.x and the iOS 26.2 SDK.
// Keep the deployment target on the major iOS release so the same app can
// run on the current physical iPhone and the matching simulator runtime.
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.2
DEVELOPMENT_LANGUAGE = pl
PRODUCT_BUNDLE_IDENTIFIER = app.rootine.ios.dev
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
TARGETED_DEVICE_FAMILY = 1

ROOTINE_SUPABASE_URL =
ROOTINE_SUPABASE_PUBLISHABLE_KEY =
ROOTINE_BACKEND_URL =
ROOTINE_AUTH_CALLBACK_SCHEME = rootine
// Debug/simulator builds use the APNs sandbox. Release CI must set this to
// production in its private xcconfig or xcodebuild settings.
ROOTINE_APNS_ENVIRONMENT = sandbox
// Apple calls the sandbox entitlement "development"; the server contract
// intentionally calls the same environment "sandbox".
ROOTINE_APNS_ENTITLEMENT_ENVIRONMENT = development
ROOTINE_TERMS_URL =
ROOTINE_PRIVACY_URL =

// B01 safe defaults. Environment-specific xcconfig files may select a
// deployment, but rollout flags stay off until the server evaluates an
// account-scoped override.
ROOTINE_ENVIRONMENT = development
ROOTINE_NORMALIZED_SYNC_ENABLED = NO
ROOTINE_NORMALIZED_READ_ENABLED = NO
ROOTINE_NOTIFICATIONS_ENABLED = NO

#include? "Secrets.xcconfig"
