{
  "name": "routine-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false",
    "css:lint": "stylelint \"src/**/*.{css,scss}\"",
    "css:lint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "css:audit": "node scripts/css-audit.mjs",
    "css:audit:json": "node scripts/css-audit.mjs --json"
  },
  "dependencies": {
    "impeccable": "^3.3.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2"
  },
  "devDependencies": {
    "@projectwallace/stylelint-plugin": "^0.6.12",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "wallace-cli": "^4.0.2"
  }
}
