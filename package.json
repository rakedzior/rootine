{
  "name": "rootine-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "lint": "eslint src api functions worker e2e scripts playwright.config.ts playwright.global-setup.ts playwright.global-teardown.ts vite.config.ts vitest.config.ts --max-warnings=0",
    "typecheck": "npm run typecheck:app && npm run typecheck:api",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json --pretty false",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json --pretty false",
    "test": "vitest run",
    "test:api": "vitest run api",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:viewport": "playwright test --grep @viewport-matrix",
    "test:e2e:zoom": "playwright test --grep @zoom-matrix",
    "smoke:production": "node scripts/smoke-production.mjs",
    "css:lint": "stylelint \"src/**/*.{css,scss}\"",
    "css:lint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "css:audit": "node scripts/css-audit.mjs",
    "css:audit:json": "node scripts/css-audit.mjs --json",
    "design-system:audit": "node --test scripts/design-system-inline-audit.test.mjs scripts/design-system-source-audit.test.mjs scripts/goals-design-system-utility.test.mjs scripts/app-design-system-utility.test.mjs && node scripts/design-system-audit.mjs",
    "architecture:audit": "node scripts/architecture-audit.mjs",
    "ios:audit": "node scripts/ios-project-audit.mjs",
    "check": "npm run lint && npm run css:lint && npm run design-system:audit && npm run architecture:audit && npm run ios:audit && npm run test && npm run typecheck && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "impeccable": "^3.3.0",
    "lucide-react": "^0.542.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@projectwallace/stylelint-plugin": "^0.6.12",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.0",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.10",
    "wallace-cli": "^4.0.2",
    "wrangler": "^4.115.0"
  }
}
