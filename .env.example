# Server-only contact included in Open Food Facts requests.
# Set this to a real, monitored maintainer email address or project URL in production.
OPEN_FOOD_FACTS_CONTACT=

# Server-side values used by authenticated API routes. On Cloudflare set these
# as Worker/Pages variables; on Vercel set them as server environment values.
# A publishable/anon key is expected here, never the service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Optional on hosts that do not expose the bundled /api serverless function.
# Point this at a same-origin or CORS-enabled Open Food Facts proxy endpoint.
VITE_OPEN_FOOD_FACTS_PROXY_URL=/api/openfoodfacts/search

# Browser-safe Supabase connection values. Prefer the publishable key; the anon
# name is supported for legacy projects. Set the URL and exactly one key to
# enable accounts; leave all three empty for local-only mode. Never use a
# service-role/secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
