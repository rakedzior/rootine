# Server-only contact included in Open Food Facts requests.
# Set this to a real, monitored maintainer email address or project URL in production.
OPEN_FOOD_FACTS_CONTACT=

# Optional on hosts that do not expose the bundled /api serverless function.
# Point this at a same-origin or CORS-enabled Open Food Facts proxy endpoint.
VITE_OPEN_FOOD_FACTS_PROXY_URL=/api/openfoodfacts/search
