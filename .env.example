# Server-only contact included in Open Food Facts requests.
# Set this to a real, monitored maintainer email address or project URL in production.
OPEN_FOOD_FACTS_CONTACT=

# Optional on hosts that do not expose the bundled /api serverless function.
# Point this at a same-origin or CORS-enabled Open Food Facts proxy endpoint.
VITE_OPEN_FOOD_FACTS_PROXY_URL=/api/openfoodfacts/search

# Browser-safe Supabase connection values. Prefer the publishable key; the anon
# name is supported for legacy projects. Never use a service-role/secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Rootine Assistant is fail-closed. Set this to true only after access protection,
# an exact origin allowlist, durable rate limiting, and provider spend limits exist.
ROOTINE_ASSISTANT_ENABLED=false

# Server-only OpenAI credentials and Realtime defaults. Never prefix these with VITE_.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin

# Comma-separated exact browser origins, for example:
# ROOTINE_ASSISTANT_ALLOWED_ORIGINS=http://localhost:5173,https://rootine.example
ROOTINE_ASSISTANT_ALLOWED_ORIGINS=

# Optional private-deployment gate. Clients send this as Authorization: Bearer <token>.
# Do not bundle or persist this value in browser localStorage.
ROOTINE_ASSISTANT_ACCESS_TOKEN=

# Client-enforced lifecycle limits returned by the status endpoint.
ROOTINE_ASSISTANT_MAX_SESSION_MINUTES=10
ROOTINE_ASSISTANT_IDLE_TIMEOUT_SECONDS=120

# Session bootstrap safeguards. The in-memory rate limit is per runtime instance;
# production still requires a durable platform/WAF rate limit.
ROOTINE_ASSISTANT_UPSTREAM_TIMEOUT_MS=12000
ROOTINE_ASSISTANT_RATE_LIMIT=5
ROOTINE_ASSISTANT_RATE_WINDOW_SECONDS=60
